# این فایل را به نام .env کپی و مقادیرش را پر کنید (خود .env در گیت ثبت نمی‌شود).

# ── جنگو و پایگاه‌داده (فاز ۰ تا ۲) ──
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=conference_db
DB_USER=dev
DB_PASSWORD=devpass
DB_HOST=localhost
DB_PORT=5432

# ── لایه‌ی عامل‌ها (فاز ۳) ──
# با False پورتال بدون هیچ تماسی با n8n و دقیقاً مثل فاز ۲ کار می‌کند
AGENTS_ENABLED=True
# راز مشترک پورتال و n8n؛ یک رشته‌ی تصادفی بسازید:  python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_TOKEN=change-me-to-a-long-random-string
# نشانی Webhookهای n8n از دید پورتال
N8N_WEBHOOK_URL=http://localhost:5678/webhook
# نشانی پورتال از دید کاربر (پیوند داخل ایمیل‌ها)
PORTAL_PUBLIC_URL=http://localhost:8000

# ── مدل‌ها (این بخش را فقط n8n می‌خواند؛ docker-compose آن را به کانتینر می‌دهد) ──
# پیش‌فرض: Ollama روی همین مک. از درون داکر، «همین مک» یعنی host.docker.internal
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_CHAT_MODEL=gemma3:4b
EMBEDDING_MODEL=bge-m3
# اگر مدل embedding روی سرویس دیگری است (پیش‌فرض: همان سرویس مدل گفتگو)
# EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
# EMBEDDING_API_KEY=ollama
# طول هر تکه از متن پیشنهاد که برای اعتبارسنجی به مدل داده می‌شود (برای مدل‌های ابری می‌تواند بزرگ‌تر باشد)
# VALIDATION_WINDOW_CHARS=4000
# فرستنده‌ی ایمیل‌های اعلان
# MAIL_FROM=portal@example.com
